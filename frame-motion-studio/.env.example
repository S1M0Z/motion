# Copier ce fichier en .env.local, remplir côté serveur puis redémarrer Next.
# Sans clé, le mode démo local reste actif. Ne jamais utiliser NEXT_PUBLIC_ pour une clé.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Envoyer à Claude jusqu'à 6 images réduites : 4 captures, 1 image, 1 logo.
# false pour ne transmettre que les métadonnées et le brief.
ANTHROPIC_SEND_IMAGES=true
# Ancien adaptateur optionnel, uniquement avec AI_PROVIDER=openai :
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# REMOTION_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
